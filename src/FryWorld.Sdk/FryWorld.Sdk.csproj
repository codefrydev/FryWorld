<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FryWorld.Sdk</AssemblyName>
    <RootNamespace>FryWorld.Sdk</RootNamespace>
    <PackageId Condition="'$(PackageId)' == ''">FryWorld.Sdk</PackageId>
    <Title>FryWorld Plugin &amp; Runtime SDK</Title>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!--
      Plugin ABI version. This assembly is the plugin contract: external plugins compile against it
      and do not bundle it (PrivateAssets="all"), so its assembly identity stays fixed at 1.0.0.0.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Pure, high-performance plugin microkernel, dynamic registries, and runtime SDK for the FryWorld platform</Description>
    <PackageDescription>Cross-platform SDK and microkernel for building plugins, workspaces, and tools for FryWorld.</PackageDescription>
    <PackageTags>fryworld;plugin;sdk;microkernel;cordis;extensibility</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
