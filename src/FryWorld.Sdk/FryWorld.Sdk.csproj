<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FryWorld.Sdk</AssemblyName>
    <RootNamespace>FryWorld.Sdk</RootNamespace>
    <PackageId Condition="'$(PackageId)' == ''">FryWorld.Sdk</PackageId>
    <Title>FryWorld Plugin &amp; Runtime SDK</Title>
    <Version Condition="'$(Version)' == ''">0.0.2</Version>
    <!--
      Plugin ABI version. This assembly is the plugin contract: external plugins compile against it
      and do not bundle it (PrivateAssets="all"), so its assembly identity stays fixed at 1.0.0.0.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Code Fry Dev</Authors>
    <Company>Code Fry Dev</Company>
    <Copyright>Copyright © 2026 Code Fry Dev</Copyright>
    <Description>Pure, high-performance plugin microkernel, dynamic registries, and runtime SDK for the FryWorld platform</Description>
    <PackageDescription>Cross-platform SDK and microkernel for building plugins, workspaces, and tools for FryWorld.</PackageDescription>
    <PackageTags>fryworld;plugin;sdk;microkernel;cordis;extensibility</PackageTags>
    <PackageProjectUrl>https://github.com/codefrydev/FryWorld</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codefrydev/FryWorld</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
