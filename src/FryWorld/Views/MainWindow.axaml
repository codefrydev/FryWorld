<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FryWorld.ViewModels"
        xmlns:views="using:FryWorld.Views"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="FryWorld.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FryWorld - Creative &amp; Developer Suite"
        Icon="/Assets/app-logo.ico"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource M3SurfaceBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Cmd+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Cmd+B" Command="{Binding ToggleNavRailCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleNavRailCommand}" />
    <KeyBinding Gesture="Cmd+1" Command="{Binding OpenLauncherCommand}" />
    <KeyBinding Gesture="Ctrl+1" Command="{Binding OpenLauncherCommand}" />
    <KeyBinding Gesture="Cmd+2" Command="{Binding OpenPluginsManagerCommand}" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding OpenPluginsManagerCommand}" />
    <KeyBinding Gesture="Cmd+T" Command="{Binding ToggleThemeCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
    <KeyBinding Gesture="Cmd+Shift+T" Command="{Binding ApplyRandomHarmonicCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ApplyRandomHarmonicCommand}" />
    <KeyBinding Gesture="Cmd+OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Cmd+J" Command="{Binding ToggleStatusBarCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleStatusBarCommand}" />
  </Window.KeyBindings>

  <!-- macOS / System Native Menu Bar -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Workspaces">
        <NativeMenu>
          <NativeMenuItem Header="Suite Launcher" Gesture="Cmd+1" Command="{Binding OpenLauncherCommand}" />
          <NativeMenuItem Header="Plugins &amp; Extensions" Gesture="Cmd+2" Command="{Binding OpenPluginsManagerCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Toggle Left Navigation Rail" Gesture="Cmd+B" Command="{Binding ToggleNavRailCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Tools">
        <NativeMenu>
          <NativeMenuItem Header="Settings &amp; Appearance..." Gesture="Cmd+," Command="{Binding OpenSettingsCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Command Palette..." Gesture="Cmd+K" Command="{Binding OpenCommandPaletteCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Toggle Theme" Gesture="Cmd+T" Command="{Binding ToggleThemeCommand}" />
          <NativeMenuItem Header="🎲 Roll Random Theme (Infinite)" Gesture="Cmd+Shift+T" Command="{Binding ApplyRandomHarmonicCommand}" />
          <NativeMenuItem Header="Toggle Bottom Status Bar" Gesture="Cmd+J" Command="{Binding ToggleStatusBarCommand}" />
          <NativeMenuItem Header="Themes">
            <NativeMenu>
              <NativeMenuItem Header="Dark+ (Default)" Command="{Binding ApplyThemeCommand}" CommandParameter="dark-plus" />
              <NativeMenuItem Header="Light+ (Default)" Command="{Binding ApplyThemeCommand}" CommandParameter="light-plus" />
              <NativeMenuItem Header="Dracula Pro" Command="{Binding ApplyThemeCommand}" CommandParameter="dracula" />
              <NativeMenuItem Header="Cyberpunk Neon" Command="{Binding ApplyThemeCommand}" CommandParameter="cyberpunk" />
              <NativeMenuItem Header="Monokai Classic" Command="{Binding ApplyThemeCommand}" CommandParameter="monokai" />
              <NativeMenuItem Header="One Dark Pro" Command="{Binding ApplyThemeCommand}" CommandParameter="one-dark" />
              <NativeMenuItem Header="Nord Arctic" Command="{Binding ApplyThemeCommand}" CommandParameter="nord" />
              <NativeMenuItemSeparator />
              <NativeMenuItem Header="🎲 Random Color Harmony" Command="{Binding ApplyRandomHarmonicCommand}" />
            </NativeMenu>
          </NativeMenuItem>
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">

    <!-- ========================================== -->
    <!-- 1. LEFT NAVIGATION RAIL                    -->
    <!-- ========================================== -->
    <Border Grid.Row="0" Grid.Column="0"
            Width="72"
            IsVisible="{Binding IsNavRailVisible}"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,1,0">

      <Grid RowDefinitions="Auto,*,Auto" Margin="0,16">

        <!-- Top FryWorld Logo Pill -->
        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
          <material:MaterialIcon Kind="RocketLaunch" Width="24" Height="24" Foreground="{DynamicResource M3OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Navigation Rail Items -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavigationRailItem">
              <Button Classes="nav-rail-btn"
                      Classes.selected="{Binding IsSelected}"
                      Width="52" Height="52"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Center"
                      ToolTip.Tip="{Binding Title}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectNavigationItem}"
                      CommandParameter="{Binding}">
                <material:MaterialIcon Kind="{Binding IconKind}" Width="24" Height="24" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Bottom Actions (⌘K Command Palette, Theme Toggle, Collapse Rail) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="10">
          <!-- ⌘K Palette -->
          <Button Classes="icon-btn" Width="44" Height="44" Command="{Binding OpenCommandPaletteCommand}" ToolTip.Tip="Command Palette (⌘K / Ctrl+K)">
            <material:MaterialIcon Kind="Flash" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" />
          </Button>

          <!-- Theme Toggle -->
          <Button Classes="icon-btn" Width="44" Height="44" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle Theme (⌘T) · Right-click for Presets">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Theme Presets" IsEnabled="False" FontWeight="Bold" />
                <Separator />
                <MenuItem Header="Dark+ (Default)" Command="{Binding ApplyThemeCommand}" CommandParameter="dark-plus" />
                <MenuItem Header="Light+ (Default)" Command="{Binding ApplyThemeCommand}" CommandParameter="light-plus" />
                <MenuItem Header="Dracula Pro" Command="{Binding ApplyThemeCommand}" CommandParameter="dracula" />
                <MenuItem Header="Cyberpunk Neon" Command="{Binding ApplyThemeCommand}" CommandParameter="cyberpunk" />
                <MenuItem Header="Monokai Classic" Command="{Binding ApplyThemeCommand}" CommandParameter="monokai" />
                <MenuItem Header="One Dark Pro" Command="{Binding ApplyThemeCommand}" CommandParameter="one-dark" />
                <MenuItem Header="Nord Arctic" Command="{Binding ApplyThemeCommand}" CommandParameter="nord" />
                <Separator />
                <MenuItem Header="🎲 Random Color Harmony" Command="{Binding ApplyRandomHarmonicCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
            <material:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>

          <!-- Infinite Theme Generator (Roll Random Theme) -->
          <Button Classes="icon-btn" Width="44" Height="44" Command="{Binding ApplyRandomHarmonicCommand}" ToolTip.Tip="🎲 Infinite Theme Generator: Roll Random Theme (⌘⇧T / Ctrl+Shift+T)">
            <material:MaterialIcon Kind="DiceMultipleOutline" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" />
          </Button>

          <!-- Settings Button -->
          <Button Classes="icon-btn" Width="44" Height="44" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings &amp; Appearance (⌘,)">
            <material:MaterialIcon Kind="CogOutline" Width="20" Height="20" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>

          <!-- Collapse Rail Button -->
          <Button Classes="icon-btn" Width="44" Height="36" Command="{Binding ToggleNavRailCommand}" ToolTip.Tip="Collapse Navigation Rail (⌘B / Ctrl+B)">
            <material:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ========================================== -->
    <!-- 2. MAIN VIEWPORT & OVERLAY LAYER           -->
    <!-- ========================================== -->
    <Grid Grid.Row="0" Grid.Column="1">

      <!-- View Switcher -->
      <Panel>
        <!-- A. Launcher Home View -->
        <Panel IsVisible="{Binding IsLauncherActive}">
          <views:LauncherHomeView DataContext="{Binding LauncherHomeVm}" />
        </Panel>

        <!-- B. Plugins Manager View -->
        <Panel IsVisible="{Binding IsPluginsActive}">
          <views:PluginsManagerPageView DataContext="{Binding PluginsManagerVm}" />
        </Panel>

        <!-- C. Settings & Appearance View -->
        <Panel IsVisible="{Binding IsSettingsActive}">
          <views:SettingsPageView DataContext="{Binding SettingsVm}" />
        </Panel>

        <!-- D. Dynamic Workspace Studio Plugin View (e.g. C# Studio, Image Editor) -->
        <ContentControl Content="{Binding CurrentView}"
                        IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>

      <!-- Floating Shell Overlays Layer -->
      <views:ShellOverlayHost DataContext="{Binding}" />

      <!-- Command Palette Dialog (⌘K) Modal Overlay -->
      <Panel IsVisible="{Binding IsCommandPaletteOpen}">
        <views:CommandPaletteDialog DataContext="{Binding CommandPaletteVm}" />
      </Panel>
    </Grid>

    <!-- ========================================== -->
    <!-- 3. BOTTOM STATUS BAR                       -->
    <!-- ========================================== -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Height="26"
            IsVisible="{Binding IsStatusBarVisible}"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="icon-btn" Width="20" Height="20" Padding="0" Command="{Binding ToggleNavRailCommand}" ToolTip.Tip="Toggle Left Navigation Rail (⌘B / Ctrl+B)">
            <material:MaterialIcon Kind="DockLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>
          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding LoadedPluginCount, StringFormat='Active Plugins: {0}'}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MemoryUsageText, StringFormat='Heap: {0}'}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <material:MaterialIcon Kind="Circle" Width="8" Height="8" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Online" FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
