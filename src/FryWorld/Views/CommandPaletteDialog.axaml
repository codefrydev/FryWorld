<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FryWorld.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="FryWorld.Views.CommandPaletteDialog"
             x:DataType="vm:CommandPaletteViewModel">

  <Border Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Width="560"
            MaxHeight="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,80,0,0"
            Padding="16"
            BoxShadow="0 16 32 #80000000">

      <Grid RowDefinitions="Auto,*">

        <!-- Search Input -->
        <TextBox Grid.Row="0"
                 Classes="m3-search"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="Type a command or search tools..."
                 Height="42"
                 FontSize="14"
                 Margin="0,0,0,12" />

        <!-- Command Results List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding FilteredCommands}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:CommandPaletteItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                <material:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding ShortcutKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding ShortcutKey}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
    </Border>
  </Border>
</UserControl>
