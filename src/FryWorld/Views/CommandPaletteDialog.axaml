<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FryWorld.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="FryWorld.Views.CommandPaletteDialog"
             x:DataType="vm:CommandPaletteViewModel"
             Focusable="True">

  <Border x:Name="BackdropBorder"
          Background="#CC000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          PointerPressed="OnBackdropPointerPressed">
    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
            BorderBrush="{DynamicResource M3OutlineBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Width="560"
            MaxHeight="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,80,0,0"
            Padding="16"
            BoxShadow="0 16 32 #80000000"
            PointerPressed="OnCardPointerPressed">

      <Grid RowDefinitions="Auto,*">

        <!-- Search Input Row with Close Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBox Grid.Column="0"
                   x:Name="SearchBox"
                   Classes="m3-search"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   PlaceholderText="Type a command or search tools..."
                   Height="42"
                   FontSize="14"
                   KeyDown="OnSearchKeyDown" />

          <!-- Close / Esc Action Button -->
          <Button Grid.Column="1"
                  Command="{Binding CloseCommand}"
                  Classes="m3-icon-btn"
                  Width="36" Height="36"
                  Margin="8,0,0,0"
                  CornerRadius="10"
                  Background="{DynamicResource M3SurfaceContainerHighBrush}"
                  ToolTip.Tip="Close (Esc)">
            <material:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource M3OnSurfaceBrush}" />
          </Button>
        </Grid>

        <!-- Command Results List -->
        <ListBox Grid.Row="1"
                 x:Name="CommandsListBox"
                 ItemsSource="{Binding FilteredCommands}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 DoubleTapped="OnListBoxDoubleTapped"
                 KeyDown="OnListBoxKeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:CommandPaletteItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                <material:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding ShortcutKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding ShortcutKey}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
    </Border>
  </Border>
</UserControl>

