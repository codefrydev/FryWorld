<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FryWorld.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="FryWorld.Views.ShellOverlayHost"
             x:DataType="vm:MainViewModel">

  <!-- Floating Overlays Layer -->
  <ItemsControl ItemsSource="{Binding ActiveOverlays}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <Canvas />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="vm:ActiveOverlayViewModel">
        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource M3OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Width="{Binding Width}"
                Height="{Binding Height}"
                BoxShadow="0 12 24 #80000000"
                Canvas.Left="60"
                Canvas.Top="60">

          <Grid RowDefinitions="Auto,*">

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="12,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" />
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Classes="icon-btn"
                        Padding="4"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CloseOverlayCommand}"
                        CommandParameter="{Binding}">
                  <material:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Button>
              </Grid>
            </Border>

            <!-- Plugin View Content -->
            <ContentControl Grid.Row="1" Content="{Binding View}" />

          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
