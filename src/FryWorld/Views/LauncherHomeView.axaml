<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FryWorld.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:marketplace="using:FryWorld.Sdk.Marketplace"
             x:Class="FryWorld.Views.LauncherHomeView"
             x:DataType="vm:LauncherHomeViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource M3SurfaceBrush}">

    <!-- ======================================================== -->
    <!-- ZONE 1: TOP HEADER (Branding, View Toggle, External Links)-->
    <!-- ======================================================== -->
    <Border Grid.Row="0"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Logo & Suite Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <material:MaterialIcon Kind="RocketLaunch" Width="24" Height="24" Foreground="{DynamicResource M3PrimaryBrush}" />
          <TextBlock Text="FRYWORLD" FontSize="18" FontWeight="Black" LetterSpacing="1" VerticalAlignment="Center" Foreground="{DynamicResource M3OnSurfaceBrush}" />

          <!-- LAUNCHER Pill Badge -->
          <Border CornerRadius="{DynamicResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerHighestBrush}" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="LAUNCHER" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource M3PrimaryBrush}" />
          </Border>

          <TextBlock Text="APP SUITE" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>

        <!-- Right Side: Grid / Table Toggle & Links -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

          <!-- View Mode Toggle Capsule (GRID / TABLE) -->
          <Border CornerRadius="8" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                      Classes="toggle-capsule-btn"
                      Classes.active="{Binding IsGridMode}">
                <TextBlock Text="GRID" FontSize="10" FontWeight="Bold" LetterSpacing="0.5" />
              </Button>
              <Button Command="{Binding SetViewModeCommand}" CommandParameter="Table"
                      Classes="toggle-capsule-btn"
                      Classes.active="{Binding IsTableMode}">
                <TextBlock Text="TABLE" FontSize="10" FontWeight="Bold" LetterSpacing="0.5" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Community Links -->
          <Button Classes="icon-btn" ToolTip.Tip="Discord Community">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="DISCORD" FontSize="11" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
              <material:MaterialIcon Kind="ArrowTopRight" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
            </StackPanel>
          </Button>

          <!-- Refresh Button -->
          <Button Command="{Binding RefreshCatalogCommand}" Classes="icon-btn" ToolTip.Tip="Reload Catalog Feed">
            <material:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======================================================== -->
    <!-- ZONE 2: FILTER & SEARCH TOOLBAR                           -->
    <!-- ======================================================== -->
    <Border Grid.Row="1"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- Status Filter Segmented Capsule -->
        <Border Grid.Column="0" Classes="segmented-filter-bar">
          <StackPanel Orientation="Horizontal" Spacing="4">

            <!-- ALL -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="All"
                    CornerRadius="6" Padding="10,4" BorderThickness="0" Cursor="Hand"
                    Background="{DynamicResource M3SurfaceContainerHighestBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="ALL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                <TextBlock Text="{Binding AllCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- INSTALLED -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Installed"
                    CornerRadius="6" Padding="10,4" BorderThickness="0" Cursor="Hand" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="INSTALLED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                <TextBlock Text="{Binding InstalledCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
              </StackPanel>
            </Button>

            <!-- UPDATES -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Updates"
                    CornerRadius="6" Padding="10,4" BorderThickness="0" Cursor="Hand" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="UPDATES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                <TextBlock Text="{Binding UpdatesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
              </StackPanel>
            </Button>

            <!-- NOT INSTALLED -->
            <Button Command="{Binding SetFilterCommand}" CommandParameter="NotInstalled"
                    CornerRadius="6" Padding="10,4" BorderThickness="0" Cursor="Hand" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="NOT INSTALLED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                <TextBlock Text="{Binding NotInstalledCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Sort Dropdown -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="SORT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort}"
                    CornerRadius="8"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    Foreground="{DynamicResource M3OnSurfaceBrush}"
                    Height="32" MinWidth="130" FontSize="12" />
        </StackPanel>

        <!-- Search Input -->
        <TextBox Grid.Column="3"
                 Classes="m3-search"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="Search apps..."
                 Width="220"
                 Height="34" />
      </Grid>
    </Border>

    <!-- ======================================================== -->
    <!-- ZONE 3: SUITE APP CARDS (GRID & TABLE MODES)             -->
    <!-- ======================================================== -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24">
      <Panel>

        <!-- A. 4-COLUMN SUITE APP CARDS GRID -->
        <ItemsControl ItemsSource="{Binding FilteredApps}" IsVisible="{Binding IsGridMode}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:LauncherAppCardViewModel">
              <Border Classes="launcher-card" Margin="6" Padding="16,14" VerticalAlignment="Top">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                  <!-- 1. Header: 52x52 Official Brand Icon Squircle + Title + Category + Options Menu -->
                  <Grid Grid.Row="0" ColumnDefinitions="52,*,Auto" Margin="0,0,0,10">
                    <!-- Squircle with Official Vector / Plugin Logo -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                            Background="{Binding IconBackgroundBrush}"
                            BorderBrush="{Binding IndexColorHex}" BorderThickness="1.5"
                            BoxShadow="0 4 12 #20000000"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                      <Panel>
                        <!-- Official Brand Dragon Logo Bitmap -->
                        <Image Source="{Binding IconBitmap}"
                               Width="48" Height="48"
                               Stretch="Uniform"
                               IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Fallback Vector Glyph -->
                        <material:MaterialIcon Kind="{Binding IconKind}"
                                               Width="26" Height="26"
                                               Foreground="{Binding IndexColorHex}"
                                               IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>

                    <!-- Title, Index Tag, Category -->
                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center" Spacing="3">
                      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <!-- Index Tag Pill -->
                        <Border Grid.Column="0" Background="{Binding IndexColorHex}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding IndexTag}" FontSize="9" FontWeight="Black" Foreground="White" />
                        </Border>
                        <!-- App Title -->
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="Black" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center">
                          <Run Text="{Binding TitlePrefix}" Foreground="{DynamicResource M3OnSurfaceBrush}" /><Run Text="{Binding TitleSuffix}" Foreground="{Binding IndexColorHex}" />
                        </TextBlock>
                      </Grid>

                      <!-- Category & Short Version Line -->
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        <TextBlock Text="•" FontSize="9" Foreground="{DynamicResource M3OutlineBrush}" />
                        <TextBlock Text="{Binding VersionShortText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                      </StackPanel>
                    </StackPanel>

                    <!-- Context Menu Button (...) -->
                    <Button Grid.Column="2"
                            CornerRadius="8"
                            Width="30" Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="App Options"
                            VerticalAlignment="Top">
                      <material:MaterialIcon Kind="DotsVertical" Width="18" Height="18" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Launch App" Command="{Binding ExecutePrimaryActionCommand}" IsVisible="{Binding IsInstalled}">
                            <MenuItem.Icon>
                              <material:MaterialIcon Kind="RocketLaunch" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Uninstall App" Command="{Binding ExecuteUninstallCommand}" IsVisible="{Binding IsInstalled}">
                            <MenuItem.Icon>
                              <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#EF4444"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <Separator IsVisible="{Binding IsInstalled}"/>
                          <MenuItem Header="Copy Extension ID" Command="{Binding CopyIdCommand}">
                            <MenuItem.Icon>
                              <material:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Visit Website ↗" Command="{Binding OpenWebsiteCommand}">
                            <MenuItem.Icon>
                              <material:MaterialIcon Kind="Web" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Source Repository ↗" Command="{Binding OpenRepositoryCommand}">
                            <MenuItem.Icon>
                              <material:MaterialIcon Kind="Github" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>

                  <!-- 2. Description (2 Full Lines with TextTrimming) -->
                  <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                             Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                             TextWrapping="Wrap" MaxLines="2" LineHeight="15"
                             Margin="0,0,0,10" />

                  <!-- 3. Metadata Badges: Status Badge + Single Real Size Pill + Multi-Version Dropdown -->
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalAlignment="Center">
                    <!-- Left: Status Pill + Real Size Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <!-- Status Badge -->
                      <Border CornerRadius="6" Background="{Binding StatusBackgroundBrush}" Padding="7,3">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <material:MaterialIcon Kind="{Binding StatusIconKind}" Width="11" Height="11" Foreground="{Binding StatusForegroundBrush}" />
                          <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.4" Foreground="{Binding StatusForegroundBrush}" />
                        </StackPanel>
                      </Border>

                      <!-- Single Real File Size Pill (Visible ONLY when FormattedSize is non-empty) -->
                      <Border CornerRadius="6" Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                              BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                              Padding="7,3"
                              IsVisible="{Binding FormattedSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <material:MaterialIcon Kind="Harddisk" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding FormattedSize}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Right: Multi-version ComboBox if multiple versions exist -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              IsVisible="{Binding HasMultipleVersions}"
                              Height="26" MinWidth="80" FontSize="10.5" Padding="6,2"
                              CornerRadius="6"
                              Background="{DynamicResource M3SurfaceContainerLowBrush}"
                              BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                              Foreground="{DynamicResource M3OnSurfaceBrush}"
                              ToolTip.Tip="Select package version">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marketplace:MarketplacePluginVersion">
                          <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10.5" FontWeight="SemiBold" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <!-- 4. Downloading Progress Indicator (Visible when IsBusy) -->
                  <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding IsBusy}">
                    <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding InstallProgress}"
                                 Height="5" CornerRadius="2.5"
                                 Foreground="{Binding IndexColorHex}"
                                 Background="{DynamicResource M3SurfaceContainerHighestBrush}" />
                    <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="9" FontWeight="Bold"
                               Foreground="{Binding IndexColorHex}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                  </Grid>

                  <!-- 5. Action Button Row: Full-Width Primary Action with Icon -->
                  <Button Grid.Row="4"
                          Classes="m3-card-action"
                          Command="{Binding ExecutePrimaryActionCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          HorizontalAlignment="Stretch"
                          Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="{Binding PrimaryActionIconKind}" Width="15" Height="15" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding PrimaryActionText}" FontSize="12" FontWeight="Black" LetterSpacing="0.8" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- B. TABULAR SUITE APP LIST -->
        <ItemsControl ItemsSource="{Binding FilteredApps}" IsVisible="{Binding IsTableMode}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:LauncherAppCardViewModel">
              <Border Classes="launcher-card" Margin="0,0,0,8" Padding="14,10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                  <!-- Index Tag -->
                  <Border Grid.Column="0" Classes="launcher-index-tag" Background="{Binding IndexColorHex}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IndexTag}" FontSize="10" FontWeight="Black" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Border>

                  <!-- Icon Squircle with Vector / Plugin Logo -->
                  <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10"
                          Background="{Binding IconBackgroundBrush}"
                          BorderBrush="{Binding IndexColorHex}" BorderThickness="1.5"
                          BoxShadow="0 2 8 #18000000"
                          ClipToBounds="True"
                          Margin="0,0,14,0" VerticalAlignment="Center">
                    <Panel>
                      <Image Source="{Binding IconBitmap}"
                             Width="34" Height="34"
                             Stretch="Uniform"
                             IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <material:MaterialIcon Kind="{Binding IconKind}"
                                             Width="20" Height="20"
                                             Foreground="{Binding IndexColorHex}"
                                             IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>

                  <!-- Title & Description -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="{Binding TitlePrefix}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                      <TextBlock Text="{Binding TitleSuffix}" FontSize="14" FontWeight="Black" Foreground="{Binding IndexColorHex}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>

                  <!-- Category Pill -->
                  <Border Grid.Column="3" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                  </Border>

                  <!-- Status Pill -->
                  <Border Grid.Column="4" CornerRadius="6" Background="{Binding StatusBackgroundBrush}" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="{Binding StatusIconKind}" Width="11" Height="11" Foreground="{Binding StatusForegroundBrush}" />
                      <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusForegroundBrush}" />
                    </StackPanel>
                  </Border>

                  <!-- Size Pill (Visible ONLY when FormattedSize is not empty) -->
                  <Border Grid.Column="5" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsVisible="{Binding FormattedSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="Harddisk" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FormattedSize}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>

                  <!-- Version -->
                  <Panel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              IsVisible="{Binding HasMultipleVersions}"
                              Height="26" MinWidth="85" FontSize="11" Padding="6,2"
                              CornerRadius="6"
                              Background="{DynamicResource M3SurfaceContainerLowBrush}"
                              BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                              Foreground="{DynamicResource M3OnSurfaceBrush}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marketplace:MarketplacePluginVersion">
                          <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" FontWeight="SemiBold" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding VersionShortText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                               IsVisible="{Binding !HasMultipleVersions}" VerticalAlignment="Center" />
                  </Panel>

                  <!-- Action Button -->
                  <Button Grid.Column="7"
                          Classes="m3-card-action"
                          Command="{Binding ExecutePrimaryActionCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          Width="120" Height="32"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <material:MaterialIcon Kind="{Binding PrimaryActionIconKind}" Width="13" Height="13" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding PrimaryActionText}" FontSize="11" FontWeight="Black" LetterSpacing="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- Menu Button with Flyout -->
                  <Button Grid.Column="8"
                          CornerRadius="8"
                          Width="32" Height="32"
                          Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                          BorderThickness="0"
                          Cursor="Hand"
                          VerticalAlignment="Center">
                    <material:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Launch App" Command="{Binding ExecutePrimaryActionCommand}" IsVisible="{Binding IsInstalled}">
                          <MenuItem.Icon>
                            <material:MaterialIcon Kind="RocketLaunch" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}"/>
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Uninstall App" Command="{Binding ExecuteUninstallCommand}" IsVisible="{Binding IsInstalled}">
                          <MenuItem.Icon>
                            <material:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#EF4444"/>
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator IsVisible="{Binding IsInstalled}"/>
                        <MenuItem Header="Copy Extension ID" Command="{Binding CopyIdCommand}">
                          <MenuItem.Icon>
                            <material:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Visit Website ↗" Command="{Binding OpenWebsiteCommand}">
                          <MenuItem.Icon>
                            <material:MaterialIcon Kind="Web" Width="16" Height="16"/>
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Source Repository ↗" Command="{Binding OpenRepositoryCommand}">
                          <MenuItem.Icon>
                            <material:MaterialIcon Kind="Github" Width="16" Height="16"/>
                          </MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Panel>
    </ScrollViewer>

    <!-- ======================================================== -->
    <!-- ZONE 4: FOOTER BAR (Catalog Status & Platform Info)      -->
    <!-- ======================================================== -->
    <Border Grid.Row="3"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusFooterText}" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="WEBSITE ↗" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          <TextBlock Text="GITHUB ↗" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          <TextBlock Text="DISCORD ↗" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          <TextBlock Text="INSTALLING FOR MACOS / WINDOWS / LINUX" FontSize="10" FontWeight="Black" LetterSpacing="0.8" Foreground="{DynamicResource M3PrimaryBrush}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
