<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FryWorld.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="FryWorld.Views.PluginsManagerPageView"
             x:DataType="vm:PluginsManagerViewModel">

  <Grid RowDefinitions="Auto,*" Background="{DynamicResource M3SurfaceBrush}">

    <!-- Top Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource M3SurfaceContainerLowestBrush}"
            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <material:MaterialIcon Kind="ToyBrickOutline" Width="24" Height="24" Foreground="{DynamicResource M3PrimaryBrush}" />
          <TextBlock Text="PLUGINS &amp; EXTENSIONS STUDIO" FontSize="16" FontWeight="Black" LetterSpacing="0.8" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Search & Refresh -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
          <Button Command="{Binding RefreshMarketplaceCommand}" Classes="icon-btn" ToolTip.Tip="Refresh Marketplace">
            <material:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content List -->
    <ScrollViewer Grid.Row="1" Padding="24">
      <StackPanel Spacing="16">
        <!-- Problems: why a plugin did not load or mount -->
        <Border Classes="launcher-card" IsVisible="{Binding HasProblems}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <material:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20"
                                     Foreground="{DynamicResource M3ErrorBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Problems" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"
                         Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding ClearProblemsCommand}" Classes="icon-btn" ToolTip.Tip="Clear">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PluginProblemViewModel">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10" ToolTip.Tip="{Binding Details}">
                    <material:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                      <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="Installed Plugins" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />

        <ItemsControl ItemsSource="{Binding InstalledPlugins}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PluginItemViewModel">
              <Border Classes="launcher-card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                    <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                  <ToggleSwitch Grid.Column="2"
                                IsChecked="{Binding IsEnabled}"
                                Command="{Binding $parent[UserControl].((vm:PluginsManagerViewModel)DataContext).TogglePluginCommand}"
                                CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
